{
  "tools": [
    {
      "name": "web_research",
      "version": "1.0.0",
      "endpoint": "http://localhost:8765/tools/run",
      "method": "POST",
      "tags": [
        "research",
        "web",
        "locality"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "zip": {
            "type": "string"
          }
        },
        "required": [
          "zip"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "leads": {
            "type": "array"
          }
        }
      },
      "enabled": true,
      "description": "Search for local insurers/agents by zip."
    }
  ]
}